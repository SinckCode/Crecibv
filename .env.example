# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values
# Get these from Firebase Console > Project Settings > General > Your Apps

REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Meta Pixel (opcional)
# Administrador de eventos de Meta > Origenes de datos > tu pixel > ID
# Si se deja vacio, el pixel no se carga y el resto del sitio funciona igual.
# Solo se inyecta cuando la persona acepta el aviso de cookies.
REACT_APP_META_PIXEL_ID=your_meta_pixel_id
